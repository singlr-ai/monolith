<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.standardapplied</groupId>
  <artifactId>monolith-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>

  <name>Monolith</name>
  <description>Live, typed queries on real Postgres for Java. A schema, typed data access, a client
    reader, and reactive live queries generated from one declaration, over libpq via Panama FFM.</description>
  <url>https://github.com/singlr-ai/monolith</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <organization>
    <name>Standard Applied Intelligence Labs</name>
    <url>https://standardapplied.com</url>
  </organization>

  <developers>
    <developer>
      <name>Standard Applied Intelligence Labs</name>
      <organization>Standard Applied Intelligence Labs</organization>
      <organizationUrl>https://standardapplied.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/singlr-ai/monolith.git</connection>
    <developerConnection>scm:git:ssh://github.com:singlr-ai/monolith.git</developerConnection>
    <url>https://github.com/singlr-ai/monolith</url>
  </scm>

  <modules>
    <module>monolith-api</module>
    <module>monolith-codegen</module>
    <module>monolith-runtime</module>
    <module>monolith-reactive</module>
    <module>monolith-queue</module>
    <module>monolith-helidon</module>
    <module>examples/collab</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <helidon.version>4.1.6</helidon.version>
    <junit.version>6.0.2</junit.version>
    <surefire.version>3.5.4</surefire.version>
    <jacoco.version>0.8.14</jacoco.version>
    <!-- Set by the JaCoCo agent at build time; empty default so the build works if jacoco is skipped. -->
    <surefireArgLine></surefireArgLine>
  </properties>

  <!-- Inherited by every module: JUnit 6 on the test classpath. -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <!-- JUnit 6 BOM: aligns jupiter, platform, and launcher versions. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Helidon SE (optional adapter only). Imported as a BOM so the adapter pins one version. -->
      <dependency>
        <groupId>io.helidon</groupId>
        <artifactId>helidon-bom</artifactId>
        <version>${helidon.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-codegen</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-reactive</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-queue</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.standardapplied</groupId>
        <artifactId>monolith-helidon</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <!-- JaCoCo agent (set into surefireArgLine) plus native access for the libpq FFM path. -->
            <argLine>@{surefireArgLine} --enable-native-access=ALL-UNNAMED</argLine>
            <!-- Run unit tests and the *IT integration tests together; the latter self-skip with
                 no Postgres, so coverage is collected wherever a database is reachable. -->
            <includes>
              <include>**/*Test.java</include>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Preflight: fail fast with a crisp message when a contributor builds on an older JDK, rather
           than emitting confusing downstream compiler errors. The library targets JDK 25 (Panama FFM). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-jdk-25</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>This project requires JDK 25 or newer (Panama FFM). See README "Requirements".</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Coverage: instrument tests and emit a per-module report under target/site/jacoco. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <propertyName>surefireArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- Excluded: the live streaming-replication boundary (native libpq downcalls,
                   server-timed protocol messages, a background drain thread) whose branches can't
                   be driven deterministically. All are integration-tested, just not gated. -->
              <excludes>
                <exclude>monolith/pg/runtime/Pg.class</exclude>
                <exclude>monolith/pg/runtime/WalStream.class</exclude>
                <exclude>monolith/pg/reactive/Invalidator.class</exclude>
                <!-- Scheduled daemon poller of slot health; its sequential logic is the gated
                     SlotHealth/Wal.health, integration-tested in SlotMonitorIT. -->
                <exclude>monolith/pg/reactive/SlotMonitor.class</exclude>
                <!-- Threaded worker driver: a daemon claim loop, virtual-thread dispatch, and a
                     scheduled lease heartbeat. Its sequential logic lives in Delivery (gated 100%);
                     the driver itself is integration-tested in WorkerIT but not line-gated, like the
                     other daemon-thread components above. -->
                <exclude>monolith/pg/queue/Worker.class</exclude>
                <exclude>monolith/pg/queue/Worker$Builder.class</exclude>
              </excludes>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.0</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.0</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- -Pci requires the database harness: it sets monolith.requireDb=true so RequireDatabaseIT turns
         a missing or non-logical Postgres into a hard build failure instead of letting the database
         integration tests silently self-skip. CI runs `mvn -Pci ... verify` after starting postgres:18
         with wal_level=logical; run it locally the same way to reproduce CI exactly. -->
    <profile>
      <id>ci</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <monolith.requireDb>true</monolith.requireDb>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- -Pbenchmarks adds the JMH module. Kept out of the default reactor so the offline
         `mvn verify` and CI never need to download JMH or run benchmarks. Build the runner with
         `mvn -Pbenchmarks -pl monolith-benchmarks -am package`, then run benchmarks.jar with
         native access enabled (see the module README). -->
    <profile>
      <id>benchmarks</id>
      <modules>
        <module>monolith-benchmarks</module>
      </modules>
    </profile>

    <!-- -Psoak runs the test fork under a deliberately small heap with native-memory tracking on, so
         a leak or allocation-pressure bug surfaces here instead of hiding behind a dev box's abundant
         RAM. Pair with a long MONOLITH_STRESS_SECONDS for a real soak of the FFM path. -->
    <profile>
      <id>soak</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>@{surefireArgLine} --enable-native-access=ALL-UNNAMED -Xmx256m
                -XX:NativeMemoryTracking=summary</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Activated with -Prelease to publish to Maven Central (com.standardapplied). Attaches sources
         and javadoc, GPG-signs, flattens the parent's managed versions into each artifact's POM, and
         uploads via the Sonatype Central Publisher. Mirrors the Helios release setup. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <linksource>true</linksource>
              <!-- The library targets JDK 25 / Panama FFM; skip strict doc linting so a stray tag
                   does not fail a release. -->
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <version>1.7.3</version>
            <configuration>
              <flattenMode>ossrh</flattenMode>
            </configuration>
            <executions>
              <execution>
                <id>flatten</id>
                <phase>process-resources</phase>
                <goals>
                  <goal>flatten</goal>
                </goals>
              </execution>
              <execution>
                <id>flatten-clean</id>
                <phase>clean</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
